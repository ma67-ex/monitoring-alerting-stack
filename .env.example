# Copy to .env and fill in. Every block is optional; with none set, alerts only show on the dashboard.

# Probe an HTTP health endpoint (comma-separated). Up = HTTP 200 and, if the JSON body has a "status", HEALTHY or WARNING.
# PROBE_URLS=https://example.com/api/health
# PROBE_INTERVAL=300

# Phone push via the ntfy app. Pick a long random topic name: anyone who knows it can read it.
# NTFY_TOPIC=my-alerts-<random>
# NTFY_SERVER=https://ntfy.sh

# Email over SMTP (for Resend: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=<API key>)
# ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=onboarding@resend.dev
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Mute notifications for these alerts (comma-separated names from collector/alerts.json). They still show on the dashboard and in /api/alerts.
# ALERT_SILENCE=ProbeDown

# Generic JSON webhook
# ALERT_WEBHOOK_URL=
