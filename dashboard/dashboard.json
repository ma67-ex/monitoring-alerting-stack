{
  "title": "agent-service",
  "panels": [
    {"title": "Requests by status", "unit": "reqps",
     "empty": "No requests in this range. Start the load generator.",
     "query": {"fn": "rate", "metric": "agent_requests_total", "by": ["status"], "window": 30}},
    {"title": "Error rate", "unit": "percent", "warn": 0.02, "crit": 0.05, "alert": "HighErrorRate",
     "query": {"fn": "ratio",
               "num": {"fn": "rate", "metric": "agent_requests_total", "match": {"status": "500"}, "window": 60},
               "den": {"fn": "rate", "metric": "agent_requests_total", "window": 60}}},
    {"title": "p95 latency", "unit": "seconds", "warn": 0.5, "crit": 1, "alert": "HighLatencyP95",
     "query": {"fn": "quantile", "q": 0.95, "metric": "agent_request_seconds_bucket", "window": 60}},
    {"title": "Tokens per second", "unit": "ops",
     "query": {"fn": "rate", "metric": "agent_tokens_total", "window": 30}},
    {"title": "Tool failures by tool", "unit": "ops",
     "empty": "No tool failures in this range",
     "query": {"fn": "rate", "metric": "agent_tool_calls_total", "match": {"outcome": "error"}, "by": ["tool"], "window": 30}}
  ]
}
